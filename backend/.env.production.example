# =============================================================================
# SecureMailScope Production Environment Configuration
# Version: 0.5.0
# =============================================================================
#
# IMPORTANT: Copy this file to .env and configure all required values
# before deploying to production or SIH demo environment.
#
# DO NOT commit .env files with real secrets to version control.
#
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application name (no need to change)
APP_NAME=SecureMailScope

# Environment: development | staging | production
# REQUIRED for production: Must be "production"
ENVIRONMENT=production

# Debug mode: MUST be false in production
# REQUIRED: false
DEBUG=false

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Backend server binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# PostgreSQL connection settings
# REQUIRED: Change all default values

# Database user (create a dedicated user, not postgres superuser)
POSTGRES_USER=securemailscope

# Database password
# REQUIRED: Use a strong, unique password (min 16 characters)
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_16

# Database host (use container name in Docker, or hostname/IP for external DB)
POSTGRES_HOST=postgres

# Database port
POSTGRES_PORT=5432

# Database name
POSTGRES_DB=securemailscope

# =============================================================================
# REDIS SETTINGS
# =============================================================================

# Redis connection settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Redis password (OPTIONAL but recommended for production)
# Generate with: openssl rand -hex 16
# REDIS_PASSWORD=

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Secret Key
# REQUIRED: Generate a secure random key
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# JWT Algorithm (HS256 recommended)
JWT_ALGORITHM=HS256

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing rounds (12 is a good balance of security and performance)
PASSWORD_HASH_ROUNDS=12

# =============================================================================
# ADMIN USER
# =============================================================================

# Initial admin user credentials
# REQUIRED: Set a strong admin password for first deployment
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@securemailscope.local

# Admin password
# REQUIRED: Use a strong password meeting these requirements:
# - Minimum 8 characters
# - At least one uppercase letter
# - At least one lowercase letter
# - At least one digit
# - At least one special character (!@#$%^&*()_+-=[]{}|;:,.<>?)
ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# =============================================================================
# RATE LIMITING
# =============================================================================

# General API rate limits
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Login rate limits (stricter to prevent brute force)
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Upload rate limits
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60

# =============================================================================
# CORS SETTINGS
# =============================================================================

# Allowed CORS origins (comma-separated)
# REQUIRED: Set to your actual frontend URL(s)
# Example: https://securemailscope.example.com,https://www.securemailscope.example.com
# DO NOT use * in production
CORS_ORIGINS=https://localhost,https://securemailscope.local

# =============================================================================
# STORAGE SETTINGS
# =============================================================================

# Storage backend: "local" or "s3"
# REQUIRED: Set to "s3" for Render deployment (shared storage between backend and worker)
# Use "local" only for development with docker-compose
STORAGE_BACKEND=s3

# Evidence storage path (used only for local storage backend)
EVIDENCE_STORAGE_PATH=/app/data/evidence

# Reports storage path (used only for local storage backend)
REPORTS_STORAGE_PATH=/app/data/reports

# Allowed PCAP file extensions
ALLOWED_PCAP_EXTENSIONS=.pcap,.pcapng

# =============================================================================
# S3-COMPATIBLE OBJECT STORAGE (Required when STORAGE_BACKEND=s3)
# =============================================================================

# S3 Endpoint URL
# AWS S3: Leave empty (uses default AWS endpoints)
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# Backblaze B2: https://s3.us-west-004.backblazeb2.com
# REQUIRED for production
S3_ENDPOINT_URL=

# S3 Access Credentials
# REQUIRED: Generate from your S3 provider
# For Cloudflare R2: Create API token with R2 read/write permissions
# For AWS S3: Create IAM user with s3:PutObject, s3:GetObject, s3:DeleteObject permissions
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# S3 Bucket Name
# REQUIRED: Must already exist, application will not create it
# Recommended: securemailscope-evidence or similar
S3_BUCKET_NAME=

# S3 Region
# AWS S3: us-east-1, eu-west-1, etc.
# Cloudflare R2: auto (ignored, uses global network)
# Backblaze B2: us-west-004, etc.
S3_REGION=us-east-1

# =============================================================================
# PCAP PROCESSING
# =============================================================================

# Maximum PCAP file size in MB
MAX_PCAP_SIZE_MB=500

# TShark binary path
TSHARK_BINARY=tshark

# TShark processing timeout in seconds
TSHARK_TIMEOUT_SECONDS=300

# =============================================================================
# REQUEST LIMITS
# =============================================================================

# Maximum request body size in MB
MAX_REQUEST_SIZE_MB=100

# Maximum JSON request size in KB
MAX_JSON_SIZE_KB=1024

# =============================================================================
# SECURITY HEADERS
# =============================================================================

# Enable security headers (X-Content-Type-Options, X-Frame-Options, etc.)
ENABLE_SECURITY_HEADERS=true

# =============================================================================
# ML CONFIGURATION
# =============================================================================

# Enable ML-based analysis
ML_ENABLED=true

# ML model storage path
ML_MODEL_PATH=/app/data/models

# =============================================================================
# ANALYSIS EXECUTION MODE (Phase 5: Demo Deployment Support)
# =============================================================================

# Analysis execution mode: "celery" or "demo"
#
# "celery" = Use Celery worker for async analysis (production)
#            Requires separate background worker service
#            Recommended for production deployments
#
# "demo"   = Synchronous execution without separate worker (free demo)
#            Analysis runs in the HTTP request
#            May timeout on very large PCAPs (>50MB)
#            Use for free tier deployments without background workers
#
# REQUIRED: Choose based on your deployment architecture
ANALYSIS_EXECUTION_MODE=celery

# =============================================================================
# BLOCKCHAIN (OPTIONAL)
# =============================================================================

# Enable blockchain evidence anchoring
BLOCKCHAIN_ENABLED=false

# Blockchain RPC URL (only if enabled)
# BLOCKCHAIN_RPC_URL=

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# CELERY SETTINGS (OPTIONAL - defaults to Redis)
# =============================================================================

# Custom Celery broker URL (optional, defaults to Redis URL)
# CELERY_BROKER_URL=

# Custom Celery result backend URL (optional, defaults to Redis URL)
# CELERY_RESULT_BACKEND=

# =============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =============================================================================
#
# Before deploying to production, verify:
#
# [ ] ENVIRONMENT=production
# [ ] DEBUG=false
# [ ] SECRET_KEY is a unique, random 32+ character string
# [ ] POSTGRES_PASSWORD is strong and unique
# [ ] ADMIN_PASSWORD is strong and unique
# [ ] CORS_ORIGINS contains only your actual frontend URL(s)
# [ ] HTTPS is configured in NGINX
# [ ] Database is on a private network
# [ ] Redis is on a private network
# [ ] All default passwords have been changed
# [ ] Backup strategy is in place
# [ ] Monitoring is configured
#
# =============================================================================
