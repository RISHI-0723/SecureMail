# SecureMailScope Environment Configuration
# Copy this file to .env and update values as needed

# Application
APP_NAME=SecureMailScope
ENVIRONMENT=development
DEBUG=true

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
POSTGRES_USER=securemailscope
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=securemailscope

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery (optional - defaults to Redis URL if not set)
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# PCAP Processing
MAX_PCAP_SIZE_MB=500

# Evidence Storage (Phase 1+)
EVIDENCE_STORAGE_PATH=/app/data/evidence
ALLOWED_PCAP_EXTENSIONS=.pcap,.pcapng

# Logging
LOG_LEVEL=INFO
